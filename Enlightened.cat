              </constraints>
              <rules>
                <rule name="To Keep The Science Secret…" id="1f80-01b0-2a10-c1a6" hidden="false">
                  <description>If a model from this Force voluntarily Withdraws in the Withdrawal step of its Activation, its Admiral can elect to Resolve a Catastrophic Explosion with the model before removing it from play.</description>
                </rule>
              </rules>
              <modifiers>
